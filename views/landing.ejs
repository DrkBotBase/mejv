<!DOCTYPE html>
<html lang="es" class="scroll-smooth" x-data="{ 
    darkMode: localStorage.getItem('theme') ? localStorage.getItem('theme') === 'dark' : true, 
    mobileMenuOpen: false, 
    modalOpen: false, 
    activeService: null 
}" x-init="
    $watch('darkMode', val => localStorage.setItem('theme', val ? 'dark' : 'light'))
" :class="{ 'dark': darkMode }">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= info.name_page %></title>
    
    <meta name="title" content="<%= info.name_page %>">
    <meta name="description" content="<% info.desc %>">

    <meta name="keywords" content="PWA, aplicaciones web progresivas, desarrollo web, software a medida, sistemas empresariales, e-commerce, restaurantes, páginas web, desarrollo Node.js, Express, MongoDB, Colombia">
    <meta name="author" content="<% info.author %>">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">

    <meta name="language" content="Spanish">
    <meta name="revisit-after" content="7 days">
    <link rel="canonical" href="<%= info.dominio %>">

    <meta name="theme-color" content="#0041f2">
    <meta name="color-scheme" content="dark">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>

    <link rel="icon" type="image/png" href="/assets/images/icon.png">
    <link rel="apple-touch-icon" href="/assets/images/icon.png">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_CO">
    <meta property="og:site_name" content="MEJV Soluciones Digitales">
    <meta property="og:title" content="MEJV Soluciones Digitales">
    <meta property="og:description" content="Desarrollo de Aplicaciones Web Progresivas (PWA), sistemas web, e-commerce y soluciones digitales para empresas.">

    <meta property="og:url" content="https://mejv.pro/">

    <meta property="og:image" content="https://mejv.pro/assets/images/banner.jpg">
    <meta property="og:image:secure_url" content="https://mejv.pro/assets/images/banner.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="MEJV Soluciones Digitales">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="MEJV Soluciones Digitales">
    <meta name="twitter:description" content="Desarrollo de Aplicaciones Web Progresivas (PWA), sistemas web y soluciones digitales.">
    <meta name="twitter:image" content="https://mejv.pro/assets/images/banner.jpg">

    <!-- PWA 
    <link rel="manifest" href="/manifest.json">
    -->

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <script type="application/ld+json">
    {
      "@context":"https://schema.org",
      "@type":"Organization",
      "name":"MEJV Soluciones Digitales",
      "url":"https://mejv.pro",
      "logo":"https://mejv.pro/assets/images/logo.png",
      "image":"https://mejv.pro/assets/images/banner.jpg",
      "description":"Empresa especializada en desarrollo de Aplicaciones Web Progresivas (PWA), sistemas web y soluciones digitales.",
      "email":"contacto@mejv.pro",
      "sameAs":[]
    }
    </script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'mejv-blue': '#0041f2',
                        'mejv-dark': '#0a1e33',
                        'mejv-lime': '#bfeb30',
                        'mejv-white': '#ffffff',
                        'mejv-black': '#050c18',
                        'mejv-light-bg': '#f4f7fb',
                        'mejv-card-dark': '#0e263e',
                        'mejv-card-light': '#ffffff'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon-lime': '0 0 25px rgba(191, 235, 48, 0.4)',
                        'neon-blue': '0 0 25px rgba(0, 65, 242, 0.35)',
                        'light-card': '0 10px 30px -5px rgba(10, 30, 51, 0.08)'
                    }
                }
            }
        }
    </script>

    <style>
        html {
            scroll-behavior: smooth;
        }
        .reveal-on-scroll {
            opacity: 0;
            transform: translateY(25px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
            will-change: opacity, transform;
        }
        .reveal-on-scroll.is-visible {
            opacity: 1;
            transform: translateY(0);
        }
        canvas#dotCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            will-change: transform;
        }
    </style>
</head>
<body class="font-sans antialiased transition-colors duration-300 bg-mejv-light-bg text-mejv-dark dark:bg-mejv-black dark:text-mejv-white selection:bg-mejv-lime selection:text-mejv-black overflow-x-hidden relative">
    <canvas id="dotCanvas"></canvas>
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[400px] bg-gradient-to-b from-mejv-blue/10 via-mejv-lime/5 to-transparent blur-3xl pointer-events-none z-0"></div>
    <nav class="sticky top-0 z-40 backdrop-blur-md bg-mejv-white/80 dark:bg-mejv-black/80 border-b border-slate-200 dark:border-slate-800/80 transition-colors duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-mejv-lime shadow-neon-blue bg-mejv-black">
                    <img src="/assets/images/icon.png" alt="icon mejv" class="w-7 h-7">
                </div>
                <div class="flex flex-col">
                    <span class="font-display font-bold text-xl tracking-tight text-mejv-blue">
                        ME<span class="text-mejv-lime">JV</span>
                    </span>
                    <span class="text-[10px] font-mono tracking-widest uppercase text-slate-500 dark:text-slate-400">Diseño Web</span>
                </div>
            </a>
            <div class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600 dark:text-slate-300">
                <a href="#servicios" class="hover:text-mejv-blue dark:hover:text-mejv-lime transition-colors">Servicios</a>
                <a href="#ventajas" class="hover:text-mejv-blue dark:hover:text-mejv-lime transition-colors">Ventajas</a>
                <a href="#proceso" class="hover:text-mejv-blue dark:hover:text-mejv-lime transition-colors">Proceso</a>
                <a href="#contacto" class="hover:text-mejv-blue dark:hover:text-mejv-lime transition-colors">Contacto</a>
            </div>

            <div class="flex items-center gap-3">
                <button 
                    @click="darkMode = !darkMode; window.updateCanvasColors && window.updateCanvasColors()" 
                    type="button"
                    class="p-2.5 rounded-xl bg-slate-200 dark:bg-mejv-card-dark text-mejv-dark dark:text-mejv-lime border border-slate-300 dark:border-slate-700/60 hover:scale-105 transition-all"
                    aria-label="Cambiar Tema"
                >
                    <template x-if="darkMode">
                        <i data-lucide="sun" class="w-5 h-5"></i>
                    </template>
                    <template x-if="!darkMode">
                        <i data-lucide="moon" class="w-5 h-5"></i>
                    </template>
                </button>

                <a 
                    href="#contacto" 
                    class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold rounded-xl bg-mejv-blue text-mejv-white dark:bg-mejv-lime dark:text-mejv-black hover:bg-blue-700 dark:hover:bg-lime-400 transition-all shadow-neon-blue dark:shadow-neon-lime"
                >
                    Cotizar Sitio Web
                </a>

                <button 
                    @click="mobileMenuOpen = !mobileMenuOpen" 
                    type="button" 
                    class="md:hidden p-2.5 rounded-xl bg-slate-200 dark:bg-mejv-card-dark text-slate-700 dark:text-slate-200"
                >
                    <i :data-lucide="mobileMenuOpen ? 'x' : 'menu'" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <div 
            x-show="mobileMenuOpen" 
            x-transition 
            @click.outside="mobileMenuOpen = false" 
            class="md:hidden bg-mejv-white dark:bg-mejv-dark border-b border-slate-200 dark:border-slate-800 px-6 py-6 space-y-4"
        >
            <a href="#servicios" @click="mobileMenuOpen = false" class="block text-slate-700 dark:text-slate-200 font-medium">Servicios Web</a>
            <a href="#ventajas" @click="mobileMenuOpen = false" class="block text-slate-700 dark:text-slate-200 font-medium">Ventajas</a>
            <a href="#proceso" @click="mobileMenuOpen = false" class="block text-slate-700 dark:text-slate-200 font-medium">Proceso de Trabajo</a>
            <a href="#contacto" @click="mobileMenuOpen = false" class="block text-slate-700 dark:text-slate-200 font-medium">Contacto</a>
            <a 
                href="#contacto" 
                @click="mobileMenuOpen = false" 
                class="block w-full text-center py-3 rounded-xl bg-mejv-blue text-mejv-white dark:bg-mejv-lime dark:text-mejv-black font-bold"
            >
                Cotizar Sitio Web
            </a>
        </div>
    </nav>

    <section class="relative pt-12 pb-20 md:pt-24 md:pb-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
        <div class="text-center max-w-4xl mx-auto space-y-8 reveal-on-scroll">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-200 dark:bg-mejv-card-dark border border-slate-300 dark:border-slate-700 text-mejv-blue dark:text-mejv-lime text-xs sm:text-sm font-semibold">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <span>Diseño Web Moderno, Rápido y Adaptado a tu Marca</span>
            </div>
            <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-mejv-dark dark:text-mejv-white leading-[1.1]">
                Tu página web, tu mejor <br class="hidden sm:inline" />
                <span class="text-mejv-blue dark:text-mejv-lime">inversión.</span>
                <span class="block text-xl sm:text-3xl lg:text-4xl mt-3 text-slate-500 dark:text-slate-400 font-sans font-medium">
                    Para emprendedores, profesionales y negocios
                </span>
            </h1>

            <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
                Diseñamos sitios web profesionales, rápidos seguros y adaptados a tus objetivos para hacer crecer tu presencia en linea y convertir visitantes en clientes.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                <a 
                    href="#contacto" 
                    class="w-full sm:w-auto px-8 py-4 rounded-xl bg-mejv-blue text-mejv-white dark:bg-mejv-lime dark:text-mejv-black font-bold text-base shadow-neon-blue dark:shadow-neon-lime hover:scale-[1.02] transition-all flex items-center justify-center gap-3"
                >
                    <span>Solicita tu WEB Gratis</span>
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>

                <a 
                    href="#servicios" 
                    class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-200 dark:bg-mejv-card-dark text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-700 font-semibold text-base hover:bg-slate-300 dark:hover:bg-slate-800 transition-all flex items-center justify-center gap-2"
                >
                    <i data-lucide="compass" class="w-5 h-5"></i>
                    <span>Explorar Servicios</span>
                </a>
            </div>

            <div class="pt-8 flex flex-wrap items-center justify-center gap-6 text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-medium">
                <div class="flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-mejv-blue dark:text-mejv-lime"></i> 100% Responsivo (Mobile-First)
                </div>
                <div class="flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-mejv-blue dark:text-mejv-lime"></i> Optimizado para (SEO)
                </div>
                <div class="flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-mejv-blue dark:text-mejv-lime"></i> Entrega Rápida
                </div>
            </div>
        </div>
    </section>

    <section id="servicios" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10 relative">
        <div class="text-center mb-16 reveal-on-scroll">
            <h2 class="font-display text-3xl sm:text-5xl font-bold text-mejv-dark dark:text-mejv-white">
                Soluciones Web <span class="text-mejv-blue dark:text-mejv-lime">para Cada Necesidad</span>
            </h2>
            <p class="mt-4 text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-2xl mx-auto">
                Desde landing pages para campañas hasta sitios corporativos completos y marcas personales.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-7 group bg-mejv-card-light dark:bg-mejv-card-dark border border-slate-200 dark:border-slate-800/80 rounded-3xl p-8 shadow-light-card hover:border-mejv-blue dark:hover:border-mejv-lime transition-all flex flex-col justify-between reveal-on-scroll">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-mejv-blue/10 dark:bg-mejv-lime/10 border border-mejv-blue/30 dark:border-mejv-lime/30 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-6">
                        <i data-lucide="building-2" class="w-7 h-7"></i>
                    </div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold">PyMEs</span>
                    <h3 class="font-display text-2xl sm:text-3xl font-bold mt-2 mb-4 text-mejv-dark dark:text-mejv-white">Sitios Web Corporativos</h3>
                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                        Aumenta la credibilidad de tu empresa con un sitio web institucional completo. Presenta tus servicios, equipo, testimonios y ubicación con una estructura profesional optimizada para generar clientes potenciales.
                    </p>
                </div>
                <button 
                    @click="activeService = { title: 'PyMEs', detail: 'Puede incluir arquitectura multipágina, formulario de cotización, integración con Google Maps y WhatsApp, optimización SEO inicial y diseño adaptado a la identidad gráfica de tu empresa.', icon: 'building-2' }; modalOpen = true"
                    class="inline-flex items-center gap-2 text-mejv-blue dark:text-mejv-lime font-bold text-sm hover:underline"
                >
                    <span>Ver qué incluye</span>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="lg:col-span-5 group bg-mejv-card-light dark:bg-mejv-card-dark border border-slate-200 dark:border-slate-800/80 rounded-3xl p-8 shadow-light-card hover:border-mejv-blue dark:hover:border-mejv-lime transition-all flex flex-col justify-between reveal-on-scroll">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-mejv-blue/10 dark:bg-mejv-lime/10 border border-mejv-blue/30 dark:border-mejv-lime/30 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-6">
                        <i data-lucide="target" class="w-7 h-7"></i>
                    </div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold">Ventas & Campañas</span>
                    <h3 class="font-display text-2xl font-bold mt-2 mb-4 text-mejv-dark dark:text-mejv-white">Landing Pages de Ventas</h3>
                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                        Páginas únicas enfocadas en un solo objetivo: convertir visitantes en leads o compradores. Ideal para lanzamientos de productos, eventos, ofertas y pauta publicitaria.
                    </p>
                </div>
                <button 
                    @click="activeService = { title: 'Landing Pages de Ventas', detail: 'Diseño directo y persuasivo, llamadas a la acción estratégicas (CTA), velocidad de carga instantánea, formulario de contacto optimizado.', icon: 'target' }; modalOpen = true"
                    class="inline-flex items-center gap-2 text-mejv-blue dark:text-mejv-lime font-bold text-sm hover:underline"
                >
                    <span>Ver qué incluye</span>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="lg:col-span-5 group bg-mejv-card-light dark:bg-mejv-card-dark border border-slate-200 dark:border-slate-800/80 rounded-3xl p-8 shadow-light-card hover:border-mejv-blue dark:hover:border-mejv-lime transition-all flex flex-col justify-between reveal-on-scroll">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-mejv-blue/10 dark:bg-mejv-lime/10 border border-mejv-blue/30 dark:border-mejv-lime/30 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-6">
                        <i data-lucide="user-check" class="w-7 h-7"></i>
                    </div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold">Profesionales & Creadores</span>
                    <h3 class="font-display text-2xl font-bold mt-2 mb-4 text-mejv-dark dark:text-mejv-white">Marcas Personales</h3>
                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                        Destaca tu trabajo como consultor, médico, abogado, arquitecto o creador. Exhibe tus proyectos con un portafolio interactivo y agenda citas en línea.
                    </p>
                </div>
                <button 
                    @click="activeService = { title: 'Marcas Personales y Portafolios', detail: 'Galerías interactivas para proyectos, sección de trayectoria, integración de calendarios para reserva de citas (Calendly/WhatsApp) y enlaces a redes sociales.', icon: 'user-check' }; modalOpen = true"
                    class="inline-flex items-center gap-2 text-mejv-blue dark:text-mejv-lime font-bold text-sm hover:underline"
                >
                    <span>Ver qué incluye</span>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="lg:col-span-7 group bg-mejv-card-light dark:bg-mejv-card-dark border border-slate-200 dark:border-slate-800/80 rounded-3xl p-8 shadow-light-card hover:border-mejv-blue dark:hover:border-mejv-lime transition-all flex flex-col justify-between reveal-on-scroll">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-mejv-blue/10 dark:bg-mejv-lime/10 border border-mejv-blue/30 dark:border-mejv-lime/30 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-6">
                        <i data-lucide="shopping-bag" class="w-7 h-7"></i>
                    </div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-bold">Comercio Electrónico</span>
                    <h3 class="font-display text-2xl sm:text-3xl font-bold mt-2 mb-4 text-mejv-dark dark:text-mejv-white">Tiendas Online y Catálogos</h3>
                    <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                        Vende tus productos las 24 horas. Catálogos digitales autoadministrables con carritos de compra, filtros de búsqueda intuitivos y conexión directa con tus chats de ventas.
                    </p>
                </div>
                <button 
                    @click="activeService = { title: 'Tiendas Online y Catálogos', detail: 'Gestión sencilla de inventario/productos, carrito adaptable a celulares y módulo de checkout rápido sin fricción.', icon: 'shopping-bag' }; modalOpen = true"
                    class="inline-flex items-center gap-2 text-mejv-blue dark:text-mejv-lime font-bold text-sm hover:underline"
                >
                    <span>Ver qué incluye</span>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>

        </div>
    </section>

    <section id="ventajas" class="py-20 bg-slate-200/60 dark:bg-slate-950/80 border-y border-slate-300 dark:border-slate-800 transition-colors z-10 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
                <h2 class="font-display text-3xl sm:text-5xl font-bold text-mejv-dark dark:text-mejv-white">
                    ¿Por qué elegir <span class="text-mejv-blue dark:text-mejv-lime">Soluciones Digitales MEJV</span>?
                </h2>
                <p class="mt-4 text-slate-600 dark:text-slate-400 text-lg">
                    Construimos sitios web modernos con estándares actuales de calidad, velocidad y usabilidad.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="bg-mejv-card-light dark:bg-mejv-card-dark p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-light-card reveal-on-scroll">
                    <div class="w-12 h-12 rounded-xl bg-mejv-blue/10 dark:bg-mejv-lime/10 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-4">
                        <i data-lucide="smartphone" class="w-6 h-6"></i>
                    </div>
                    <h3 class="font-bold text-xl text-mejv-dark dark:text-mejv-white mb-2">Mobile-First</h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">Diseño pensado primero para celulares, donde se origina más del 80% del tráfico web actual.</p>
                </div>

                <div class="bg-mejv-card-light dark:bg-mejv-card-dark p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-light-card reveal-on-scroll">
                    <div class="w-12 h-12 rounded-xl bg-mejv-blue/10 dark:bg-mejv-lime/10 flex items-center justify-center text-mejv-blue dark:text-mejv-lime mb-4">
                        <i data-lucide="gauge" class="w-6 h-6"></i>
                    </div>
                    <h3 class="font-bold text-xl text-mejv-dark dark:text-mejv-white mb-2">Velocidad Extrema</h3>
