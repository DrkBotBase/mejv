<!doctype html>
<html lang="es" class="dark"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Campañas · MEJV</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-950 text-white"><div class="mx-auto max-w-7xl p-5 sm:p-10">
  <header class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs uppercase tracking-[.25em] text-lime-300">MEJV / TRACKING</p><h1 class="mt-2 text-4xl font-bold">Campañas WhatsApp</h1><p class="mt-2 text-slate-400">Crea un enlace, compártelo y mide sus conversaciones.</p></div><form method="post" action="/admin/logout"><button class="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-slate-500">Cerrar sesión</button></form></header>
  <% if (error) { %><div class="mb-6 rounded-xl border border-red-900 bg-red-950/50 px-4 py-3 text-red-200"><%= error %></div><% } %><% if (success) { %><div class="mb-6 rounded-xl border border-lime-900 bg-lime-950/50 px-4 py-3 text-lime-200"><%= success %></div><% } %>
  <section class="mb-10 rounded-3xl border border-slate-800 bg-slate-900 p-6 sm:p-8"><div class="mb-6"><h2 class="text-xl font-bold">Nueva campaña</h2><p class="mt-1 text-sm text-slate-400">El slug será la parte que usarás en <code class="text-lime-300">/wa?campaign=...</code>.</p></div>
    <form method="post" action="/admin/campaigns" class="grid gap-5 md:grid-cols-3"><label class="text-sm text-slate-300">Nombre visible<input name="name" required placeholder="Promo landing página" class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3"></label><label class="text-sm text-slate-300">Slug<input name="slug" required pattern="[A-Za-z0-9_-]+" placeholder="landing_page_promo-10" class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3"></label><label class="text-sm text-slate-300 md:col-span-1">Mensaje de WhatsApp<textarea name="message" rows="1" placeholder="Hola, me interesa..." class="mt-2 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3"></textarea></label><div class="md:col-span-3"><button class="rounded-xl bg-lime-300 px-5 py-3 font-bold text-slate-950 hover:bg-lime-200">Crear campaña</button></div></form>
  </section>
  <section class="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900"><div class="border-b border-slate-800 px-6 py-5"><h2 class="text-xl font-bold">Campañas creadas</h2></div><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="bg-slate-950/60 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4">Campaña</th><th class="px-6 py-4">Enlace</th><th class="px-6 py-4">Clics</th><th class="px-6 py-4">Estado</th><th class="px-6 py-4">Acción</th></tr></thead><tbody class="divide-y divide-slate-800"><% campaigns.forEach(campaign => { %><tr class="hover:bg-slate-800/30"><td class="px-6 py-5"><div class="font-semibold"><%= campaign.name %></div><div class="mt-1 text-xs text-slate-500"><%= campaign.message || 'Sin mensaje predeterminado' %></div></td><td class="px-6 py-5"><a target="_blank" rel="noreferrer" class="break-all text-lime-300 hover:underline" href="<%= baseUrl %>/wa?campaign=<%= campaign.slug %>"><%= baseUrl %>/wa?campaign=<%= campaign.slug %></a></td><td class="px-6 py-5 text-2xl font-bold"><%= campaign.clicks || 0 %></td><td class="px-6 py-5"><span class="rounded-full px-3 py-1 text-xs <%= campaign.active ? 'bg-lime-300/10 text-lime-300' : 'bg-slate-800 text-slate-500' %>"><%= campaign.active ? 'Activa' : 'Pausada' %></span></td><td class="px-6 py-5"><form method="post" action="/admin/campaigns/<%= campaign._id %>/toggle"><button class="text-sm text-slate-300 underline hover:text-white"><%= campaign.active ? 'Pausar' : 'Activar' %></button></form></td></tr><% }) %><% if (!campaigns.length) { %><tr><td colspan="5" class="px-6 py-12 text-center text-slate-500">Aún no hay campañas. Crea la primera arriba.</td></tr><% } %></tbody></table></div></section>
</div></body></html>
